+.detail-btn-row {
+  display: flex;
+  gap: 8px;
+  margin-bottom: 16px;
+}
+
+.detail-btn {
+  flex: 1;
+  background: #fff;
+  color: var(--navy);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 10px 6px;
+  font-size: 12px;
+  font-weight: 600;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  cursor: pointer;
+  transition: background .15s, border-color .15s;
+}
+
+.detail-btn i {
+  font-size: 15px;
+}
+
+.detail-btn:hover {
+  background: #eef2ff;
+  border-color: var(--navy-light);
+}
